# ── Python & Bytecode ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ── Virtual Environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
*.env
*.pem
*.key

# ── Heavy data ─────────────────────────────────────────────────────────────
# Caches that take hours to rebuild are committed through Git LFS (see
# .gitattributes): walk_graph.gpickle, catchments_network.gpkg,
# osrm_responses.json, the WorldPop raster, clipped building footprints.
# Only intermediates that are large AND quick/cheap to regenerate stay out.
data/cache/a08a_polys/
data/external/ms_buildings/*.csv.gz
data/raw/*.pbf
*.pbf

# ── Operating System & Editor Artifacts ──────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Temporary & Scratch Files ────────────────────────────────────────────────
tmp/
temp/
scratch/
*.tmp
*.bak

data/external/ms_buildings/dataset-links.csv
